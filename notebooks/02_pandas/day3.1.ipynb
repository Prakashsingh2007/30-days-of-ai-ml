    "import numpy as np\n",
    "\n",
    "marks = np.random.randint(40,101,20)\n",
    "\n",
    "print(marks)\n",
    "\n",
    "print(\"Mean:\", marks.mean())\n",
    "\n",
    "print(\"Median:\", np.median(marks))\n",
    "\n",
    "print(\"Variance:\", marks.var())\n",
    "\n",
    "print(\"Standard Deviation:\", marks.std())"
   ]
